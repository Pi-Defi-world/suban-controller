# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
NETWORK=testnet

# Cache and aggregation
CACHE_TTL_SECONDS=10
CHAIN_DATA_CACHE_TTL=30
SOURCE_MAX_AGE_MS=30000
OUTLIER_THRESHOLD_PERCENT=10
MIN_SOURCES_REQUIRED=1
CIRCUIT_BREAKER_THRESHOLD_BPS=500
CIRCUIT_BREAKER_PAUSE_MS=60000
DEVIATION_ALERT_THRESHOLD_BPS=300

# Price history persistence (SQLite)
PRICE_DB_PATH=./data/prices.db
PRICE_RETENTION_DAYS=30

# Trust state thresholds
TRUST_DEGRADED_CONFIDENCE=0.5
TRUST_MIN_SOURCE_RATIO=0.5
TRUST_RECOVERY_STREAK=3

# Source weights
WEIGHT_COINGECKO=1.5
WEIGHT_OKX=2.0
WEIGHT_BITGET=2.0
WEIGHT_MEXC=3.0
WEIGHT_ARC=1.5

# Local Horizon / RPC endpoints
HORIZON_MAINNET_URL=http://localhost:41401
HORIZON_TESTNET_URL=http://localhost:31401

# Control plane authentication (REQUIRED for price commit / breaker reset)
# Generate with: openssl rand -hex 32
CONTROLLER_ADMIN_API_KEY=
CONTROLLER_CONTROL_RATE_LIMIT=30

# On-chain oracle publication (disabled by default)
ORACLE_PUSH_ENABLED=false
ORACLE_CONTRACT_ID=
ORACLE_ASSET=
ORACLE_RPC_URL=https://rpc.testnet.minepi.com
ORACLE_NETWORK_PASSPHRASE=Pi Testnet
ORACLE_ADMIN_SECRET=
ORACLE_PRICE_DECIMALS=7
ORACLE_PUSH_INTERVAL_MS=60000

# Arc price source (optional)
ARC_RPC_URL=
ARC_PRICE_PAIR_ADDRESS=
