# Suban Controller (Data Oracle)

# Server
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# Network (mainnet or testnet)
NETWORK=mainnet

# Horizon API URLs (our own nodes)
HORIZON_MAINNET_URL=http://pi-mainnet:8000
HORIZON_TESTNET_URL=http://pi-testnet:8000

# Cache
CACHE_TTL_SECONDS=10
CHAIN_DATA_CACHE_TTL=30

# Price source symbols
PI_SYMBOL_COINGECKO=pi-network
PI_SYMBOL_OKX=PI-USDT
PI_SYMBOL_BITGET=PIUSDT

# Outlier detection
OUTLIER_THRESHOLD_PERCENT=10
MIN_SOURCES_REQUIRED=1

# Source weights
WEIGHT_COINGECKO=1.5
WEIGHT_OKX=2.0
WEIGHT_BITGET=2.0

# Transaction streaming
TX_STREAM_POLL_MS=5000
TX_STREAM_BUFFER_SIZE=100

# Staleness: max age of a price source before it's excluded (ms)
SOURCE_MAX_AGE_MS=30000

# Circuit breaker: max deviation in bps from last committed price before pause
CIRCUIT_BREAKER_THRESHOLD_BPS=500

# Circuit breaker: auto-pause duration after trigger (ms)
CIRCUIT_BREAKER_PAUSE_MS=60000

# Deviation alert threshold in bps (logs alert but doesn't pause)
DEVIATION_ALERT_THRESHOLD_BPS=300

# On-chain Oracle (Pi testnet)
ORACLE_CONTRACT_ID=CBLQKWBP2TV3CPM26DDNMEMDEMLGYAJHJ5O2ZM4UD32OVXBOCA25DE3M
ORACLE_RPC_URL=https://rpc.testnet.minepi.com
ORACLE_NETWORK_PASSPHRASE=Pi Testnet
ORACLE_ADMIN_SECRET=SCB2NN44YEITKM2TEXCTPP3LB33DXFI3M7PKCVJU24UFELY6TTFGOD44
