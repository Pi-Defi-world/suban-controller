{
  "name": "@suban/controller",
  "version": "1.2.0",
  "description": "Data oracle for Pi Network - price feeds and on-chain analytics",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "pi-network",
    "suban",
    "oracle",
    "price-feed",
    "on-chain-analytics",
    "data-platform"
  ],
  "author": "Pi Defi World",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pi-Defi-world/suban-controller.git"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^12.0.0",
    "axios": "^1.6.2",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "node-cache": "^5.1.2",
    "prom-client": "^15.1.3",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
